{
    "name": "cakephp/app",
    "description": "CakePHP 5 Image Manager",
    "license": "MIT",
    "type": "project",
    "homepage": "https://cakephp.org",

    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "5.3.*",
        "cakephp/migrations": "^4.0",
        "cakephp/plugin-installer": "^2.0",
        "cakephp/authentication": "^4.2",
        "cakephp/authorization": "^3.4",
        "mobiledetect/mobiledetectlib": "^4.8.03"
    },

    "require-dev": {
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "josegonzalez/dotenv": "^4.0",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },

    "suggest": {
        "cakephp/repl": "Console tools for a REPL interface for CakePHP applications.",
        "dereuromark/cakephp-ide-helper": "Keeps annotations in sync for IDE and static analysis.",
        "markstory/asset_compress": "Asset compression and minification.",
        "phpstan/phpstan": "Static analysis for PHP."
    },

    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },

    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": true,
        "sort-packages": true
    },

    "scripts": {
        "post-install-cmd": "App\\Console\\Installer::postInstall",
        "post-create-project-cmd": "App\\Console\\Installer::postInstall",
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "test": "phpunit --colors=always"
    }
}
